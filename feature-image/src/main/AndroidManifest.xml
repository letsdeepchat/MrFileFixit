<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      BatchImageWorker is plain background work. WorkManager's foreground service is removed so the app declares no
      foreground service at all, which Play would otherwise ask to justify with a video.
    -->
    <application>
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
    </application>
</manifest>
