{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrfilefixit.app/schema/exam-rules/v2",
  "title": "Mr File Fixit exam rules",
  "description": "Photo, signature and certificate upload requirements per exam. Community-sourced unless marked verified against an official page; never official. Users must verify against the official notification.",
  "type": "object",
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": [
        "id",
        "shortName",
        "name",
        "category",
        "conductingBody",
        "lastVerified",
        "verification",
        "documents"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "shortName": {
          "description": "Short label for cards, e.g. \"SSC CGL\".",
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "category": {
          "enum": [
            "SSC",
            "UPSC",
            "BANKING",
            "RAILWAYS",
            "DEFENCE",
            "ENTRANCE",
            "TEACHING",
            "STATE_PSC",
            "OTHER"
          ]
        },
        "conductingBody": {
          "type": "string"
        },
        "lastVerified": {
          "description": "Date the values were last checked against the official notification, or null if never checked.",
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "verification": {
          "description": "verified: checked against the official page or notification on lastVerified. community: from public guides and past notices.",
          "enum": [
            "verified",
            "community"
          ]
        },
        "notes": {
          "type": "string"
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "composite": {
          "$ref": "#/$defs/composite"
        },
        "certificates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/certificate"
          }
        }
      },
      "if": {
        "properties": {
          "verification": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "lastVerified": {
            "type": "string"
          }
        }
      }
    },
    "document": {
      "type": "object",
      "required": [
        "kind",
        "formats",
        "sizeKb",
        "widthPx",
        "heightPx",
        "targetPx"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "photo",
            "postcard_photo",
            "signature",
            "left_thumb",
            "declaration",
            "other"
          ]
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "jpeg",
              "png",
              "webp"
            ]
          }
        },
        "sizeKb": {
          "$ref": "#/$defs/range"
        },
        "widthPx": {
          "$ref": "#/$defs/range"
        },
        "heightPx": {
          "$ref": "#/$defs/range"
        },
        "targetPx": {
          "description": "Pixel size the app generates. Must lie inside widthPx/heightPx.",
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "kilobyteBytes": {
          "description": "How the portal counts one KB. Defaults to 1024.",
          "enum": [
            1000,
            1024
          ]
        },
        "notes": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "ink": {
          "type": "string"
        }
      }
    },
    "composite": {
      "description": "Photo above signature in a single image.",
      "type": "object",
      "required": [
        "document",
        "photoFraction"
      ],
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/document"
        },
        "photoFraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "range": {
      "description": "Inclusive bounds. Omit a bound for no limit on that side.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "certificate": {
      "description": "A supporting document the portal asks for. Shown as guidance; the app does not generate it.",
      "type": "object",
      "required": [
        "name",
        "formats",
        "sizeKb"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "pdf",
              "jpeg"
            ]
          }
        },
        "sizeKb": {
          "$ref": "#/$defs/range"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
