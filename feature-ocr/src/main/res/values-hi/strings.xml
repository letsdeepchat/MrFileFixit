    </plurals>
    <string name="ocr_detected">इस्तेमाल की गई भाषा: %1$s</string>
    <string name="ocr_no_text">कोई टेक्स्ट नहीं मिला. ज़्यादा रोशनी में साफ़ फ़ोटो लें, या भाषा ख़ुद चुनें.</string>
    <string name="ocr_copy">टेक्स्ट कॉपी करें</string>
