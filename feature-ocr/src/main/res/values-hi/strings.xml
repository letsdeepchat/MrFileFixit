<resources>
    <string name="ocr_title">टेक्स्ट पहचान (OCR)</string>
    <string name="ocr_pick_title">इमेज या PDF चुनें</string>
    <string name="ocr_pick_hint">JPG, PNG, WebP या PDF. टेक्स्ट इसी फ़ोन पर पढ़ा जाता है; कुछ भी अपलोड नहीं होता.</string>
    <string name="ocr_change_files">फ़ाइलें बदलें</string>
    <plurals name="ocr_files">
        <item quantity="one">%d फ़ाइल</item>
        <item quantity="other">%d फ़ाइलें</item>
    </plurals>
    <string name="ocr_language">भाषा</string>
    <string name="ocr_script_AUTO">अपने-आप पहचानें</string>
    <string name="ocr_script_LATIN">अंग्रेज़ी और लैटिन</string>
    <string name="ocr_script_DEVANAGARI">हिंदी और देवनागरी</string>
    <string name="ocr_script_CHINESE">चीनी</string>
    <string name="ocr_script_JAPANESE">जापानी</string>
    <string name="ocr_script_KOREAN">कोरियाई</string>
    <string name="ocr_script_hint_AUTO">पहले पेज पर हर बिल्ट-इन भाषा आज़माकर सबसे अच्छी चुनता है. अगर पेज पर कई लिपियाँ हों तो भाषा ख़ुद चुनें.</string>
    <string name="ocr_script_hint_LATIN">अंग्रेज़ी, फ़्रेंच, जर्मन, स्पेनिश, पुर्तगाली, इतालवी, डच, पोलिश, तुर्की, इंडोनेशियाई, मलय, स्वाहिली और लैटिन अक्षरों में लिखी दूसरी भाषाएँ.</string>
    <string name="ocr_script_hint_DEVANAGARI">देवनागरी में लिखी हिंदी, मराठी, नेपाली और संस्कृत. पेज पर अंग्रेज़ी शब्द भी पढ़े जाते हैं.</string>
    <string name="ocr_script_hint_CHINESE">सरलीकृत और पारंपरिक चीनी, पेज पर अंग्रेज़ी शब्दों के साथ.</string>
    <string name="ocr_script_hint_JAPANESE">जापानी कांजी, हिरागाना और काताकाना, पेज पर अंग्रेज़ी शब्दों के साथ.</string>
    <string name="ocr_script_hint_KOREAN">कोरियाई हंगुल, पेज पर अंग्रेज़ी शब्दों के साथ.</string>
    <string name="ocr_models_note">सभी भाषा मॉडल ऐप में ही हैं, इसलिए पहचान ऑफ़लाइन होती है और कभी डाउनलोड की ज़रूरत नहीं होती.</string>
    <string name="ocr_recognize">टेक्स्ट पहचानें</string>
